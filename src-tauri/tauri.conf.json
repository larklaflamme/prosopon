{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prosopon",
  "version": "0.1.0",
  "identifier": "science.ravennest.prosopon",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prosopon",
        "width": 360,
        "height": 520,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
